{
  "name": "quiz-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import ./scripts/load-root-env.mjs ./node_modules/next/dist/bin/next dev",
    "build": "node --import ./scripts/load-root-env.mjs ./node_modules/next/dist/bin/next build",
    "start": "node --import ./scripts/load-root-env.mjs ./node_modules/next/dist/bin/next start",
    "api:generate": "openapi-ts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hey-api/client-fetch": "0.13.1",
    "@next/env": "16.3.4",
    "canvas-confetti": "1.9.4",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "22.19.15",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "22.22.2",
    "pnpm": "11.25.0"
  },
  "volta": {
    "node": "22.22.2",
    "pnpm": "11.25.0"
  }
}
